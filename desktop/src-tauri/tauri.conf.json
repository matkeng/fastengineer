{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ECG Source List",
  "version": "0.1.0",
  "identifier": "com.drawingworkbench.poc",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist",
    "beforeDevCommand": "npm --prefix ../web run dev",
    "beforeBuildCommand": "npm --prefix ../web run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ECG Source List",
        "width": 1280,
        "height": 860,
        "minWidth": 760,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http: https:; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/workbench-engine"
    ],
    "shortDescription": "ECG Source List proof of concept",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "copyright": "Copyright (C) 2026 Matthew Kelly. Licensed under the GNU AGPL-3.0-only.",
    "license": "AGPL-3.0-only",
    "licenseFile": "../../LICENSE"
  }
}
