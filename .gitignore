# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/

# Nuitka output
*.build/
*.dist/
*.onefile-build/

# Tauri / Rust
desktop/src-tauri/target/
desktop/src-tauri/gen/
# Sidecar binaries are build outputs (copied in by scripts/build-*.ps1/sh)
desktop/src-tauri/binaries/*
!desktop/src-tauri/binaries/.gitkeep

# Node / front end
node_modules/
web/dist/

# Test caches
.pytest_cache/

# Portable build output
dist/

# Real generator workbooks hold project data: keep them local (golden tests read
# them from here or from $GENERATOR_FIXTURES), never commit them to this public repo
samples/generators-local/
